    {
      "parameters": {
        "jsCode": "const supplierProducts = $('Extract from File1').first().json.supplier.products;\n\nconst catalogById = new Map(\n  $input.all().map(({ json }) => [String(json.id), json])\n);\n\nreturn supplierProducts.map(product => {\n  const previous = catalogById.get(String(product.id));\n\n  return {\n    json: {\n      id: product.id,\n      title: product.title,\n      old_price: previous?.price == null ? null : Number(previous.price),\n      new_price: product.price == null ? null : Number(product.price),\n      old_stock: previous?.stock ?? null,\n      new_stock: product.stock ?? null,\n      stock_missing: product.stock == null\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -176
      ],
      "id": "554246d3-4462-4ddd-a51e-8d608db889a6",
