              "id": "ec847931-053f-4b8a-9c23-b84e6f81c383",
              "leftValue": "={{ $json.new_price }}",
              "rightValue": "={{ $json.old_price }}",
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            },
            {
              "id": "3b45406d-8a44-42f5-9b14-e7b0e3479ffd",
